char * longestNiceSubstring(char * s){
    int max_len = 0, idx = -1, n = strlen(s); // max_len: the length of result, idx: the start position
    int lower_case, upper_case; // record the position of upper case and lower case respectively
    for (int i = 0; i < n; i++) {
        lower_case = 0;
        upper_case = 0;
        for (int j = i; j < n; j++) {
            // find letter's position using c & 31 for both lower and upper case
            if (s[j] >= 'A' && s[j] <= 'Z') {
                upper_case |= (1 << (s[j] & 31));
            }
            if (s[j] >= 'a' && s[j] <= 'z') {
                lower_case |= (1 << (s[j] & 31));
            }
            
            // if the xor result is 0 that means it has both lower and upper case
            if ((upper_case ^ lower_case) == 0) {
                if (max_len < j - i + 1) {
                    max_len = j - i + 1;
                    idx = i;
                }
            }
        }
    }
    
    if (max_len == 0 || idx == -1) {
        return "";
    }
    
    // a way to copy substring in C
    char *res = (char *) calloc(max_len + 1, sizeof(char));
    memcpy(res, &s[idx], max_len);
    return res;
}
